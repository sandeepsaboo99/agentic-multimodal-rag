# ============================================================================
# InsightRAG - Environment Configuration
# Copy to `.env` and fill in. NEVER commit the real .env.
# ============================================================================

# ---- LLM (Groq) --------------------------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Text generation model (open weights, served by Groq)
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# Vision model for image understanding during ingestion (open weights)
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Cheap/fast model used by the agentic router for query classification
GROQ_ROUTER_MODEL=llama-3.1-8b-instant

# ---- Embeddings + Reranker (local, open source) ------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# If model download is not possible (air-gapped/offline), the system falls back
# to a deterministic hashing embedding so the app still runs end-to-end.
ALLOW_EMBEDDING_FALLBACK=true

# ---- Vector store (Qdrant) ---------------------------------------------------
# Leave QDRANT_URL empty to use an embedded on-disk Qdrant (no server needed).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./storage/qdrant
QDRANT_COLLECTION=insightrag_chunks

# ---- Metadata DB (SQLAlchemy) ------------------------------------------------
# Default is local SQLite; swap for postgresql+psycopg://user:pass@host/db in prod.
DATABASE_URL=sqlite:///./storage/insightrag.db

# ---- Object storage ----------------------------------------------------------
# Local dir in dev; point to a mounted S3/MinIO bucket path in prod.
OBJECT_STORAGE_PATH=./storage/objects

# ---- Auth --------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ---- Retrieval tuning --------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
RERANK_TOP_K=5
RERANK_SCORE_FLOOR=0.15     # below this, RAG evidence is considered weak

# ---- Router thresholds -------------------------------------------------------
ROUTER_USE_LLM=true         # use an LLM tie-breaker on top of the decision tree
ROUTER_RAG_CONFIDENCE=0.35  # min normalized retrieval score to trust RAG

# ---- Service wiring ----------------------------------------------------------
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO
